// Windows 7 shell32.dll dialog #1091
DLG_OPENAS_DOWNALOAD DIALOGEX 0, 0, 279, 146
CAPTION "Windows"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "Die folgende Datei kann nicht geöffnet werden:", IDC_STATIC, 36, 7, 208, 8, NOT WS_GROUP
    LTEXT "Datei:", IDC_STATIC, 36, 23, 38, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 60, 23, 208, 8, SS_NOPREFIX
    LTEXT "Das Programm, mit dem Sie diese Datei öffnen möchten, muss bekannt sein, damit sie geöffnet werden kann. Die Suche kann automatisch online erfolgen, oder Sie können manuell ein Programm aus der Liste der auf dem Computer installierten Programme auswählen.", IDC_STATIC, 9, 37, 257, 32, NOT WS_GROUP
    LTEXT "Wie möchten Sie vorgehen?", IDC_STATIC, 9, 72, 139, 8, NOT WS_GROUP
    AUTORADIOBUTTON "&Webdienst für die Suche nach dem richtigen Programm verwenden", IDD_WEBAUTOLOOKUP, 9, 86, 252, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Programm aus einer Liste installierter Programme auswählen", IDD_OPENWITHLIST, 9, 99, 230, 10, WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 156, 121, 50, 14
    PUSHBUTTON "Abbrechen", IDCANCEL, 211, 121, 50, 14
}

