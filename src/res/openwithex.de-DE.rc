    IDS_OPENAS "Öffnen mit..."
    // Windows Vista shell32.dll string #9016
    IDS_OPENAS_VISTA "Öffnen mit..."
}

// Windows 7 shell32.dll dialog #1063
DLG_OPENAS DIALOGEX 0, 0, 375, 271
CAPTION "Öffnen mit"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "Wählen Sie das Programm aus, das Sie zum Öffnen dieser Datei verwenden möchten:", IDD_TEXT, 36, 7, 339, 8, NOT WS_GROUP
    LTEXT "Datei:", IDC_STATIC, 36, 23, 37, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 75, 23, 208, 8, SS_NOPREFIX
    CONTROL "", IDD_APPLIST, "SysListView32", LVS_NOSORTHEADER | LVS_NOCOLUMNHEADER | LVS_SHAREIMAGELISTS | LVS_SHOWSELALWAYS | LVS_SINGLESEL | LVS_REPORT | WS_BORDER | WS_TABSTOP, 6, 36, 361, 170
    AUTOCHECKBOX "Dateityp &immer mit dem ausgewählten Programm öffnen", IDD_MAKEASSOC, 6, 211, 275, 10
    PUSHBUTTON "&Durchsuchen...", IDD_OPENWITH_BROWSE, 312, 211, 56, 14
    CONTROL "Sie können nach dem entsprechenden Programm <A ID=""Browse"">im Web suchen</A>, wenn sich dieses nicht in der Liste bzw. auf dem Computer befindet.", IDD_OPENWITH_WEBSITE, "SysLink", WS_TABSTOP, 8, 230, 359, 16
    DEFPUSHBUTTON "OK", IDOK, 252, 251, 56, 14
    PUSHBUTTON "Abbrechen", IDCANCEL, 312, 251, 56, 14
}

