#include "resource.h"

LANGUAGE LANG_GERMAN, SUBLANG_GERMAN

STRINGTABLE
{
    // Windows 7 shell32.dll string #29952
    IDS_OPENWITH_RECOMMENDED "Empfohlene Programme"
    // Windows 7 shell32.dll string #29953
    IDS_OPENWITH_OTHERS "Andere Programme"
    // Windows XP shell32.dll string #29952
    IDS_OPENWITH_RECOMMENDED_XP "Empfohlene Programme:"
    // Windows XP shell32.dll string #29953
    IDS_OPENWITH_OTHERS_XP "Andere Programme:"
    // Split from Windows 7 shell32.dll string #9014
    IDS_PROGRAMSFILTER "Programme"
    // Split from Windows 7 shell32.dll string #9014
    IDS_ALLFILESFILTER "Alle Dateien"
