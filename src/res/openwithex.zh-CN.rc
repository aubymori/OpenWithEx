// Windows 7 shell32.dll dialog #1063
DLG_OPENAS DIALOGEX 0, 0, 375, 271
CAPTION "打开方式"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 9, "宋体", 0, 0, 134 // GB2312_CHARSET
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "选择您想用来打开此文件的程序:", IDD_TEXT, 36, 7, 208, 9, NOT WS_GROUP
    LTEXT "文件:", IDC_STATIC, 36, 23, 22, 9, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 62, 23, 208, 9, SS_NOPREFIX
    CONTROL "", IDD_APPLIST, "SysListView32", LVS_NOSORTHEADER | LVS_NOCOLUMNHEADER | LVS_SHAREIMAGELISTS | LVS_SHOWSELALWAYS | LVS_SINGLESEL | LVS_REPORT | WS_BORDER | WS_TABSTOP, 6, 36, 361, 170
    AUTOCHECKBOX "始终使用选择的程序打开这种文件(&A)", IDD_MAKEASSOC, 6, 211, 202, 11
    PUSHBUTTON "浏览(&B)...", IDD_OPENWITH_BROWSE, 318, 211, 50, 14
    CONTROL "如果您想要的程序不在列表或您的计算机上，您可以<A ID=""Browse"">在 Web 上寻找适当的程序</A>。", IDD_OPENWITH_WEBSITE, "SysLink", WS_TABSTOP, 8, 230, 359, 17
    DEFPUSHBUTTON "确定", IDOK, 264, 251, 50, 14
    PUSHBUTTON "取消", IDCANCEL, 318, 251, 50, 14
}

