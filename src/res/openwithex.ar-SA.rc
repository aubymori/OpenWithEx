// Windows 7 shell32.dll dialog #1091
DLG_OPENAS_DOWNALOAD DIALOGEX 0, 0, 279, 146
CAPTION "Windows"
STYLE DS_CENTER | DS_MODALFRAME | WS_POPUPWINDOW | WS_CAPTION
EXSTYLE WS_EX_LAYOUTRTL
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "يتعذر على Windows فتح هذا الملف:", IDC_STATIC, 36, 7, 208, 8, NOT WS_GROUP
    LTEXT "ملف:", IDC_STATIC, 36, 23, 20, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 60, 23, 208, 8, SS_NOPREFIX
    LTEXT "لفتح هذا الملف، يجب أن يعرف Windows البرنامج الذي تريد استخدامه لفتحه. يمكن أن يقوم Windows بالاتصال بإنترنت للبحث عنه تلقائياً أو يمكنك تحديده يدوياً من قائمة البرامج المثبتة على الكمبيوتر.", IDC_STATIC, 9, 39, 257, 24, NOT WS_GROUP
    LTEXT "ماذا تريد أن تفعل؟", IDC_STATIC, 9, 72, 139, 8, NOT WS_GROUP
    AUTORADIOBUTTON "استخدام &خدمة ويب للعثور على البرنامج الصحيح", IDD_WEBAUTOLOOKUP, 9, 86, 194, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "ت&حديد البرنامج من قائمة البرامج المثبتة", IDD_OPENWITHLIST, 9, 99, 194, 10, WS_TABSTOP
    DEFPUSHBUTTON "موافق", IDOK, 156, 121, 50, 14
    PUSHBUTTON "إلغاء الأمر", IDCANCEL, 211, 121, 50, 14
}

