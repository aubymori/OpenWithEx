#pragma code_page(65001) // enable UTF-8

#include "resource.h"

LANGUAGE LANG_ARABIC, SUBLANG_ARABIC_SAUDI_ARABIA

STRINGTABLE
{
    // Windows 7 shell32.dll string #29952
    IDS_OPENWITH_RECOMMENDED "برامج ينصح بها"
    // Windows 7 shell32.dll string #29953
    IDS_OPENWITH_OTHERS "برامج أخرى"
    // Windows XP shell32.dll string #29952
    IDS_OPENWITH_RECOMMENDED_XP "برامج ينصح بها:"
    // Windows XP shell32.dll string #29953
    IDS_OPENWITH_OTHERS_XP "برامج أخرى:"
    // Split from Windows 7 shell32.dll string #9014
    IDS_PROGRAMSFILTER "Programs"
    // Split from Windows 7 shell32.dll string #9014
    IDS_ALLFILESFILTER "All Files"
    // Windows 7 shell32.dll string #9016
    IDS_OPENAS "فتح باستخدام..."
    // Windows Vista shell32.dll string #9016
    IDS_OPENAS_VISTA "فتح باستخدام..."
}

// Windows 7 shell32.dll dialog #1063
DLG_OPENAS DIALOGEX 0, 0, 375, 271
CAPTION "فتح باستخدام"
STYLE DS_CENTER | DS_MODALFRAME | WS_POPUPWINDOW | WS_CAPTION
EXSTYLE WS_EX_LAYOUTRTL
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "اختر البرنامج الذي تريد استخدامه لفتح هذا الملف:", IDD_TEXT, 36, 7, 208, 8, NOT WS_GROUP
    LTEXT "ملف:", IDC_STATIC, 36, 23, 20, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 60, 23, 208, 8, SS_NOPREFIX
    CONTROL "", IDD_APPLIST, "SysListView32", LVS_NOSORTHEADER | LVS_NOCOLUMNHEADER | LVS_SHAREIMAGELISTS | LVS_SHOWSELALWAYS | LVS_SINGLESEL | LVS_REPORT | WS_BORDER | WS_TABSTOP, 6, 36, 361, 170, WS_EX_LEFTSCROLLBAR | WS_EX_RTLREADING | WS_EX_RIGHT
    AUTOCHECKBOX "اس&تخدام البرنامج المحدد دوماً لفتح هذا النوع من الملفات", IDD_MAKEASSOC, 6, 211, 202, 10
    PUSHBUTTON "ا&ستعراض...", IDD_OPENWITH_BROWSE, 318, 211, 50, 14
    CONTROL "إذا لم يكن البرنامج الذي تريده مدرجاً بالقائمة أو لم يكن على الكمبيوتر، يمكنك <A ID=""Browse"">البحث عن البرنامج الملائم على ويب</A>.", IDD_OPENWITH_WEBSITE, "SysLink", WS_TABSTOP, 8, 230, 359, 16
    DEFPUSHBUTTON "موافق", IDOK, 264, 251, 50, 14
    PUSHBUTTON "إلغاء الأمر", IDCANCEL, 318, 251, 50, 14
}

