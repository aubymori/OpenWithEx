// Windows 7 shell32.dll dialog #1091
DLG_OPENAS_DOWNALOAD DIALOGEX 0, 0, 279, 146
CAPTION "Windows"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "Windows no puede abrir este archivo:", IDC_STATIC, 36, 7, 208, 8, NOT WS_GROUP
    LTEXT "Archivo:", IDC_STATIC, 36, 23, 29, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 69, 23, 199, 8, SS_NOPREFIX
    LTEXT "Para poder abrir el archivo, se debe indicar en Windows qué programa desea usar para tal fin. Windows  puede conectarse a Internet para buscar automáticamente, o se puede seleccionar manualmente en una lista de programas en el equipo.", IDC_STATIC, 9, 36, 257, 33, NOT WS_GROUP
    LTEXT "¿Qué desea hacer?", IDC_STATIC, 9, 73, 139, 8, NOT WS_GROUP
    AUTORADIOBUTTON "&Usar el servicio web para buscar el programa correcto", IDD_WEBAUTOLOOKUP, 9, 86, 205, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Seleccionar un programa de la lista de programas instalados", IDD_OPENWITHLIST, 9, 99, 247, 10, WS_TABSTOP
    DEFPUSHBUTTON "Aceptar", IDOK, 156, 121, 50, 14
    PUSHBUTTON "Cancelar", IDCANCEL, 211, 121, 50, 14
}

