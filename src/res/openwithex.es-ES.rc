}

// Windows 7 shell32.dll dialog #1063
DLG_OPENAS DIALOGEX 0, 0, 375, 271
CAPTION "Abrir con"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "Elija el programa que desea usar para abrir el siguiente archivo:", IDD_TEXT, 36, 7, 252, 8, NOT WS_GROUP
    LTEXT "Archivo:", IDC_STATIC, 36, 23, 29, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 69, 23, 208, 8, SS_NOPREFIX
    CONTROL "", IDD_APPLIST, "SysListView32", LVS_NOSORTHEADER | LVS_NOCOLUMNHEADER | LVS_SHAREIMAGELISTS | LVS_SHOWSELALWAYS | LVS_SINGLESEL | LVS_REPORT | WS_BORDER | WS_TABSTOP, 6, 36, 361, 170
    AUTOCHECKBOX "Usar &siempre el programa seleccionado para abrir este tipo de archivos", IDD_MAKEASSOC, 6, 211, 293, 10
    PUSHBUTTON "&Examinar...", IDD_OPENWITH_BROWSE, 318, 211, 50, 14
    CONTROL "Si el programa que busca no está en la lista o en el equipo, puede <A ID=""Browse"">buscar el programa apropiado en la Web</A>.", IDD_OPENWITH_WEBSITE, "SysLink", WS_TABSTOP, 8, 230, 359, 16
    DEFPUSHBUTTON "Aceptar", IDOK, 264, 251, 50, 14
    PUSHBUTTON "Cancelar", IDCANCEL, 318, 251, 50, 14
}

