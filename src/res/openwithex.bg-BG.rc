LANGUAGE LANG_BULGARIAN, SUBLANG_BULGARIAN_BULGARIA

STRINGTABLE
{
    // Windows 7 shell32.dll string #29952
    IDS_OPENWITH_RECOMMENDED "Препоръчвани програми"
    // Windows 7 shell32.dll string #29953
    IDS_OPENWITH_OTHERS "Други програми"
    // Windows XP shell32.dll string #29952
    IDS_OPENWITH_RECOMMENDED_XP "Препоръчани програми:"
    // Windows XP shell32.dll string #29953
    IDS_OPENWITH_OTHERS_XP "Други програми:"
    // Split from Windows 7 shell32.dll string #9014
    IDS_PROGRAMSFILTER "Програми"
    // Split from Windows 7 shell32.dll string #9014
    IDS_ALLFILESFILTER "Всички файлове"
    // Windows 7 shell32.dll string #9016
    IDS_OPENAS "Отваряне с..."
    // Windows Vista shell32.dll string #9016
    IDS_OPENAS_VISTA "Отвори с..."
}

// Windows 7 shell32.dll dialog #1063
DLG_OPENAS DIALOGEX 0, 0, 375, 271
CAPTION "Отваряне с"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "Изберете програмата, която искате да използвате, за да отворите този файл:", IDD_TEXT, 36, 7, 319, 8, NOT WS_GROUP
    LTEXT "Файл:", IDC_STATIC, 36, 23, 26, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 60, 23, 208, 8, SS_NOPREFIX
    CONTROL "", IDD_APPLIST, "SysListView32", LVS_NOSORTHEADER | LVS_NOCOLUMNHEADER | LVS_SHAREIMAGELISTS | LVS_SHOWSELALWAYS | LVS_SINGLESEL | LVS_REPORT | WS_BORDER | WS_TABSTOP, 6, 36, 361, 170
    AUTOCHECKBOX "&Винаги използвай избраната програма за отваряне на този вид файл", IDD_MAKEASSOC, 6, 211, 273, 10
    PUSHBUTTON "&Преглед...", IDD_OPENWITH_BROWSE, 318, 211, 50, 14
    CONTROL "Ако исканата програма не е в списъка или в компютъра, може <A ID=""Browse"">да потърсите подходящата програма в уеб</A>.", IDD_OPENWITH_WEBSITE, "SysLink", WS_TABSTOP, 8, 230, 359, 16
    DEFPUSHBUTTON "OK", IDOK, 264, 251, 50, 14
    PUSHBUTTON "Отказ", IDCANCEL, 318, 251, 50, 14
}

