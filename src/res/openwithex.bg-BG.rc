// Windows 7 shell32.dll dialog #1091
DLG_OPENAS_DOWNALOAD DIALOGEX 0, 0, 279, 146
CAPTION "Windows"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "Windows не може да отвори този файл:", IDC_STATIC, 36, 7, 208, 8, NOT WS_GROUP
    LTEXT "Файл:", IDC_STATIC, 36, 23, 21, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 62, 23, 208, 8, SS_NOPREFIX
    LTEXT "За да отвори този файл, Windows трябва да знае коя програма искате да използвате, за да го отворите. Windows може да премине онлайн, за да я потърси автоматично, или може ръчно да я изберете от списъка с програми, инсталирани на вашия компютър.", IDC_STATIC, 9, 39, 257, 33, NOT WS_GROUP
    LTEXT "Какво искате да направите?", IDC_STATIC, 9, 79, 139, 8, NOT WS_GROUP
    AUTORADIOBUTTON "Използвай &уеб услугата за намиране на правилната програма", IDD_WEBAUTOLOOKUP, 9, 93, 270, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Избери програмата от списък с инсталирани програми", IDD_OPENWITHLIST, 9, 106, 270, 10, WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 156, 121, 50, 14
    PUSHBUTTON "Отказ", IDCANCEL, 211, 121, 50, 14
}

