// Windows 7 shell32.dll dialog #1063
DLG_OPENAS DIALOGEX 0, 0, 375, 271
CAPTION "연결 프로그램"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 9, "굴림", 0, 0, 129
{
    ICON 134, IDD_ICON, 7, 7, 18, 22, SS_REALSIZECONTROL
    LTEXT "이 파일을 열 때 사용할 프로그램을 선택하십시오.", IDD_TEXT, 36, 7, 208, 9, NOT WS_GROUP
    LTEXT "파일:", IDC_STATIC, 36, 22, 30, 9, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 77, 23, 208, 8, SS_NOPREFIX
    CONTROL "", IDD_APPLIST, "SysListView32", LVS_NOSORTHEADER | LVS_NOCOLUMNHEADER | LVS_SHAREIMAGELISTS | LVS_SHOWSELALWAYS | LVS_SINGLESEL | LVS_REPORT | WS_BORDER | WS_TABSTOP, 6, 36, 361, 170
    AUTOCHECKBOX "이 종류의 파일을 열 때 항상 선택된 프로그램 사용(&A)", IDD_MAKEASSOC, 6, 211, 265, 10
    PUSHBUTTON "찾아보기(&B)...", IDD_OPENWITH_BROWSE, 301, 210, 66, 16
    CONTROL "원하는 프로그램이 이 목록 또는 사용자 컴퓨터에 없는 경우 <A ID=""Browse"">웹에서 프로그램</A>을 찾아볼 수 있습니다.", IDD_OPENWITH_WEBSITE, "SysLink", WS_TABSTOP, 8, 230, 359, 17
    DEFPUSHBUTTON "확인", IDOK, 264, 253, 50, 16
    PUSHBUTTON "취소", IDCANCEL, 318, 253, 50, 16
}

