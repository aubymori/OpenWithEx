    AUTORADIOBUTTON "온라인에서 프로그램 검색(&W)", IDD_WEBAUTOLOOKUP, 9, 86, 194, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "설치된 프로그램 목록에서 프로그램 선택(&S)", IDD_OPENWITHLIST, 9, 100, 194, 10, WS_TABSTOP
    DEFPUSHBUTTON "확인", IDOK, 156, 121, 50, 16
    PUSHBUTTON "취소", IDCANCEL, 211, 121, 50, 16
}

