// Windows 7 shell32.dll dialog #1091
DLG_OPENAS_DOWNALOAD DIALOGEX 0, 0, 279, 146
CAPTION "Windows"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "Windows negali atidaryti šio failo:", IDC_STATIC, 36, 7, 208, 8, NOT WS_GROUP
    LTEXT "Failas:", IDC_STATIC, 36, 23, 38, 9, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 75, 23, 193, 8, SS_NOPREFIX
    LTEXT "Norint atidaryti šį failą, sistema Windows turi žinoti, kurią programą naudosite failui atidaryti. Su sistema Windows galite prisijungti prie interneto ir automatiškai ją surasti arba neautomatiškai pasirinkti iš įdiegtų programų sąrašo kompiuteryje.", IDC_STATIC, 9, 36, 257, 33, NOT WS_GROUP
    LTEXT "Ką norite daryti?", IDC_STATIC, 9, 72, 139, 8, NOT WS_GROUP
    AUTORADIOBUTTON "&Naudodamiesi Žiniatinklio paslauga, raskite teisingą programą", IDD_WEBAUTOLOOKUP, 9, 86, 224, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Iš įdiegtų programų sąrašo pasirinkite programą", IDD_OPENWITHLIST, 9, 99, 194, 10, WS_TABSTOP
    DEFPUSHBUTTON "Gerai", IDOK, 156, 121, 50, 14
    PUSHBUTTON "Atšaukti", IDCANCEL, 211, 121, 50, 14
}

