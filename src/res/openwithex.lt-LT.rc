    IDS_OPENAS "Atidaryti naudojant..."
    // Windows Vista shell32.dll string #9016
    IDS_OPENAS_VISTA "Atidaryti naudojant..."
}

// Windows 7 shell32.dll dialog #1063
DLG_OPENAS DIALOGEX 0, 0, 375, 271
CAPTION "Atidaryti naudojant"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "Pasirinkite programą, kurią norite naudoti šiam failui atidaryti:", IDD_TEXT, 36, 7, 216, 8, NOT WS_GROUP
    LTEXT "Failas:", IDC_STATIC, 36, 23, 36, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 75, 23, 193, 8, SS_NOPREFIX
    CONTROL "", IDD_APPLIST, "SysListView32", LVS_NOSORTHEADER | LVS_NOCOLUMNHEADER | LVS_SHAREIMAGELISTS | LVS_SHOWSELALWAYS | LVS_SINGLESEL | LVS_REPORT | WS_BORDER | WS_TABSTOP, 6, 36, 361, 170
    AUTOCHECKBOX "&Pažymėtą programą visada naudoti šios rūšies failams atidaryti", IDD_MAKEASSOC, 6, 211, 301, 10
    PUSHBUTTON "&Naršyti...", IDD_OPENWITH_BROWSE, 318, 211, 50, 14
    CONTROL "Jei norimos programos nėra sąraše arba kompiuteryje, tinkamos programos galite <A ID=""Browse"">ieškoti Žiniatinklyje</A>.", IDD_OPENWITH_WEBSITE, "SysLink", WS_TABSTOP, 8, 230, 359, 16
    DEFPUSHBUTTON "Gerai", IDOK, 264, 251, 50, 14
    PUSHBUTTON "Atšaukti", IDCANCEL, 318, 251, 50, 14
}

