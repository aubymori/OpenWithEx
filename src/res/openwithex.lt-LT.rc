    // Windows 7 shell32.dll string #29953
    IDS_OPENWITH_OTHERS "Kitos programos"
    // Windows XP shell32.dll string #29952
    IDS_OPENWITH_RECOMMENDED_XP "Rekomenduojamos programos:"
    // Windows XP shell32.dll string #29953
    IDS_OPENWITH_OTHERS_XP "Kitos programos:"
    // Split from Windows 7 shell32.dll string #9014
    IDS_PROGRAMSFILTER "Programos"
    // Split from Windows 7 shell32.dll string #9014
    IDS_ALLFILESFILTER "Visi failai"
