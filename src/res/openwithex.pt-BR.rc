// Windows 7 shell32.dll dialog #1063
DLG_OPENAS DIALOGEX 0, 0, 375, 271
CAPTION "Abrir com"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "Escolha o programa a ser usado para abrir este arquivo:", IDD_TEXT, 36, 7, 306, 8, NOT WS_GROUP
    LTEXT "Arquivo:", IDC_STATIC, 36, 23, 41, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 84, 23, 208, 8, SS_NOPREFIX
    CONTROL "", IDD_APPLIST, "SysListView32", LVS_NOSORTHEADER | LVS_NOCOLUMNHEADER | LVS_SHAREIMAGELISTS | LVS_SHOWSELALWAYS | LVS_SINGLESEL | LVS_REPORT | WS_BORDER | WS_TABSTOP, 6, 36, 361, 170
    AUTOCHECKBOX "Sempre &usar o programa selecionado para abrir este tipo de arquivo", IDD_MAKEASSOC, 6, 211, 308, 10
    PUSHBUTTON "&Procurar...", IDD_OPENWITH_BROWSE, 318, 211, 50, 14
    CONTROL "Se o programa desejado não estiver na lista ou no computador, você pode <A ID=""Browse"">procurar o programa adequado na Web</A>.", IDD_OPENWITH_WEBSITE, "SysLink", WS_TABSTOP, 8, 230, 359, 16
    DEFPUSHBUTTON "OK", IDOK, 264, 251, 50, 14
    PUSHBUTTON "Cancelar", IDCANCEL, 318, 251, 50, 14
}

