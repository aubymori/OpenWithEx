// Windows 7 shell32.dll dialog #1091
DLG_OPENAS_DOWNALOAD DIALOGEX 0, 0, 279, 146
CAPTION "Windows"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "Sistēma Windows nevar atvērt šo failu:", IDC_STATIC, 36, 7, 208, 8, NOT WS_GROUP
    LTEXT "Fails:", IDC_STATIC, 36, 23, 20, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 60, 23, 208, 8, SS_NOPREFIX
    LTEXT "Sistēmai Windows jāzina, ar kādu programmu vēlaties atvērt šo failu. Sistēma Windows var pāriet tiešsaistes režīmā, lai meklētu programmu automātiski, vai arī varat to atlasīt manuāli no datorā instalēto programmu saraksta.", IDC_STATIC, 9, 39, 262, 24, NOT WS_GROUP
    LTEXT "Ko vēlaties darīt?", IDC_STATIC, 9, 72, 139, 8, NOT WS_GROUP
    AUTORADIOBUTTON "Lietot &tīmekļa pakalpojumu, lai atrastu atbilstošo programmu", IDD_WEBAUTOLOOKUP, 9, 86, 211, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Atlasīt programmu no instalēto programmu saraksta", IDD_OPENWITHLIST, 9, 99, 194, 10, WS_TABSTOP
    DEFPUSHBUTTON "Labi", IDOK, 156, 121, 50, 14
    PUSHBUTTON "Atcelt", IDCANCEL, 211, 121, 50, 14
}

