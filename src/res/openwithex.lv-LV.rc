// Windows 7 shell32.dll dialog #1063
DLG_OPENAS DIALOGEX 0, 0, 375, 271
CAPTION "Atvēršana ar"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "Izvēlieties programmu, kuru vēlaties izmantot šī faila atvēršanai:", IDD_TEXT, 36, 7, 216, 8, NOT WS_GROUP
    LTEXT "Fails:", IDC_STATIC, 36, 23, 20, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 60, 23, 208, 8, SS_NOPREFIX
    CONTROL "", IDD_APPLIST, "SysListView32", LVS_NOSORTHEADER | LVS_NOCOLUMNHEADER | LVS_SHAREIMAGELISTS | LVS_SHOWSELALWAYS | LVS_SINGLESEL | LVS_REPORT | WS_BORDER | WS_TABSTOP, 6, 36, 361, 170
    AUTOCHECKBOX "Šo atlasīto programmu &vienmēr lietot šāda veida failu atvēršanai", IDD_MAKEASSOC, 6, 211, 284, 10
    PUSHBUTTON "Pā&rlūkot...", IDD_OPENWITH_BROWSE, 318, 211, 50, 14
    CONTROL "Ja sarakstā vai datorā nav nepieciešamās programmas, <A ID=""Browse"">atbilstošo programmu var meklēt tīmeklī</A>.", IDD_OPENWITH_WEBSITE, "SysLink", WS_TABSTOP, 8, 230, 359, 16
    DEFPUSHBUTTON "Labi", IDOK, 264, 251, 50, 14
    PUSHBUTTON "Atcelt", IDCANCEL, 318, 251, 50, 14
}

