// Windows 7 shell32.dll dialog #1063
DLG_OPENAS DIALOGEX 0, 0, 375, 271
CAPTION "Abrir com"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "Escolha o programa que deseja utilizar para abrir este ficheiro:", IDD_TEXT, 36, 7, 259, 8, NOT WS_GROUP
    LTEXT "Ficheiro:", IDC_STATIC, 36, 23, 53, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 97, 23, 208, 8, SS_NOPREFIX
    CONTROL "", IDD_APPLIST, "SysListView32", LVS_NOSORTHEADER | LVS_NOCOLUMNHEADER | LVS_SHAREIMAGELISTS | LVS_SHOWSELALWAYS | LVS_SINGLESEL | LVS_REPORT | WS_BORDER | WS_TABSTOP, 6, 36, 361, 170
    AUTOCHECKBOX "&Utilizar sempre o programa seleccionado para abrir este tipo de ficheiro", IDD_MAKEASSOC, 6, 211, 294, 10
    PUSHBUTTON "Procura&r...", IDD_OPENWITH_BROWSE, 318, 211, 50, 14
    CONTROL "Se o programa que pretende não está na lista ou no computador, pode <A ID=""Browse"">procurar o programa apropriado na Web</A>.", IDD_OPENWITH_WEBSITE, "SysLink", WS_TABSTOP, 8, 230, 359, 16
    DEFPUSHBUTTON "OK", IDOK, 264, 251, 50, 14
    PUSHBUTTON "Cancelar", IDCANCEL, 318, 251, 50, 14
}

