// Windows 7 shell32.dll dialog #1091
DLG_OPENAS_DOWNALOAD DIALOGEX 0, 0, 279, 146
CAPTION "Windows"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "O Windows não consegue abrir este ficheiro:", IDC_STATIC, 36, 7, 208, 8, NOT WS_GROUP
    LTEXT "Ficheiro:", IDC_STATIC, 36, 23, 28, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 71, 23, 197, 8, SS_NOPREFIX
    LTEXT "Para abrir este ficheiro, o Windows necessita de saber qual o programa que pretende utilizar para o abrir. O Windows pode aceder à Internet para fazer uma procura automática ou pode seleccionar manualmente a partir de uma lista dos programas instalados no seu computador.", IDC_STATIC, 9, 36, 257, 32, NOT WS_GROUP
    LTEXT "O que pretende fazer?", IDC_STATIC, 9, 72, 139, 8, NOT WS_GROUP
    AUTORADIOBUTTON "Utilizar o serviço &Web para procurar o programa correcto", IDD_WEBAUTOLOOKUP, 9, 86, 264, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Seleccionar o programa na lista de programas instalados", IDD_OPENWITHLIST, 9, 99, 264, 10, WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 156, 121, 50, 14
    PUSHBUTTON "Cancelar", IDCANCEL, 211, 121, 50, 14
}

