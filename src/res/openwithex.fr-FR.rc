#pragma code_page(65001) // enable UTF-8

#include "resource.h"

LANGUAGE LANG_FRENCH, SUBLANG_FRENCH

STRINGTABLE
{
    // Windows 7 shell32.dll string #29952
    IDS_OPENWITH_RECOMMENDED "Programmes recommandés"
    // Windows 7 shell32.dll string #29953
    IDS_OPENWITH_OTHERS "Autres programmes"
    // Windows XP shell32.dll string #29952
    IDS_OPENWITH_RECOMMENDED_XP "Programmes recommandés :"
    // Windows XP shell32.dll string #29953
    IDS_OPENWITH_OTHERS_XP "Autres programmes :"
    // Split from Windows 7 shell32.dll string #9014
    IDS_PROGRAMSFILTER "Programmes"
    // Split from Windows 7 shell32.dll string #9014
    IDS_ALLFILESFILTER "Tous les fichiers"
    // Windows 7 shell32.dll string #9016
    IDS_OPENAS "Ouvrir avec..."
    // Windows Vista shell32.dll string #9016
    IDS_OPENAS_VISTA "Ouvrir avec..."
}

// Windows 7 shell32.dll dialog #1063
DLG_OPENAS DIALOGEX 0, 0, 375, 271
CAPTION "Ouvrir avec"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "Choisissez le programme à utiliser pour ouvrir ce fichier :", IDD_TEXT, 36, 7, 208, 8, NOT WS_GROUP
    LTEXT "Fichier :", IDC_STATIC, 36, 23, 30, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 67, 23, 298, 8, SS_NOPREFIX
    CONTROL "", IDD_APPLIST, "SysListView32", LVS_NOSORTHEADER | LVS_NOCOLUMNHEADER | LVS_SHAREIMAGELISTS | LVS_SHOWSELALWAYS | LVS_SINGLESEL | LVS_REPORT | WS_BORDER | WS_TABSTOP, 6, 36, 361, 170
    AUTOCHECKBOX "&Toujours utiliser le programme sélectionné pour ouvrir ce type de fichier", IDD_MAKEASSOC, 6, 211, 298, 10
    PUSHBUTTON "&Parcourir...", IDD_OPENWITH_BROWSE, 318, 211, 50, 14
    CONTROL "Si le programme que vous désirez n’est pas dans la liste ou sur votre ordinateur, vous pouvez <A ID=""Browse"">rechercher le programme approprié sur le Web</A>.", IDD_OPENWITH_WEBSITE, "SysLink", WS_TABSTOP, 8, 230, 359, 16
    DEFPUSHBUTTON "OK", IDOK, 264, 251, 50, 14
    PUSHBUTTON "Annuler", IDCANCEL, 318, 251, 50, 14
}

