// Windows 7 shell32.dll dialog #1091
DLG_OPENAS_DOWNALOAD DIALOGEX 0, 0, 279, 153
CAPTION "Windows"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "Windows ne peut pas ouvrir ce fichier :", IDC_STATIC, 36, 7, 208, 8, NOT WS_GROUP
    LTEXT "Fichier :", IDC_STATIC, 36, 23, 26, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 68, 23, 200, 8, SS_NOPREFIX
    LTEXT "Pour ouvrir ce fichier, Windows doit connaître le programme que vous souhaitez utiliser pour l’ouvrir. Windows peut effectuer une recherche en ligne automatique, ou vous pouvez choisir un programme dans la liste des programmes installés sur votre ordinateur.", IDC_STATIC, 9, 39, 264, 32, NOT WS_GROUP
    LTEXT "Que voulez-vous faire ?", IDC_STATIC, 9, 79, 139, 8, NOT WS_GROUP
    AUTORADIOBUTTON "Utiliser le service &Web pour trouver le programme approprié", IDD_WEBAUTOLOOKUP, 9, 93, 264, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Sélectionner un programme dans la liste des programmes installés", IDD_OPENWITHLIST, 9, 106, 264, 10, WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 156, 128, 50, 14
    PUSHBUTTON "Annuler", IDCANCEL, 211, 128, 50, 14
}

