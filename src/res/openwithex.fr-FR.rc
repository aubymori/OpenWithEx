    LTEXT "Cliquez sur le programme que vous souhaitez utiliser pour ouvrir le protocole '%s'.", IDD_TEXT, 7, 7, 218, 24, NOT WS_GROUP
    AUTOCHECKBOX "Toujours &utiliser ce programme pour ouvrir ce protocole", IDD_MAKEASSOC, 7, 131, 222, 10
    DEFPUSHBUTTON "OK", IDOK, 111, 157, 40, 14, WS_DISABLED
    PUSHBUTTON "Annuler", IDCANCEL, 155, 157, 40, 14
}