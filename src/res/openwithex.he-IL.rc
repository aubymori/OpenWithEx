// Windows 7 shell32.dll dialog #1091
DLG_OPENAS_DOWNALOAD DIALOGEX 0, 0, 279, 146
CAPTION "Windows"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
EXSTYLE WS_EX_LAYOUTRTL
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "ל- Windows אין אפשרות לפתוח קובץ זה:", IDC_STATIC, 36, 7, 208, 8, NOT WS_GROUP
    LTEXT "קובץ:", IDC_STATIC, 36, 23, 20, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 60, 23, 208, 8, SS_NOPREFIX, WS_EX_RTLREADING
    LTEXT "כדי לפתוח קובץ זה, על Windows לדעת באיזו תוכנית ברצונך להשתמש כדי לפתוח אותו. ל- Windows יש אפשרות לעבור למצב מקוון כדי לבדוק זאת באופן אוטומטי, ובאפשרותך גם לבחור תוכנית באופן ידני מתוך רשימת התוכניות המותקנות במחשב שלך.", IDC_STATIC, 9, 39, 266, 32, NOT WS_GROUP
    LTEXT "איזו פעולה ברצונך לבצע?", IDC_STATIC, 9, 75, 139, 8, NOT WS_GROUP
    AUTORADIOBUTTON "השתמש ב&שירות האינטרנט כדי למצוא את התוכנית הנכונה", IDD_WEBAUTOLOOKUP, 9, 89, 223, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&בחר תוכנית מתוך רשימה של תוכניות מותקנות", IDD_OPENWITHLIST, 9, 102, 194, 10, WS_TABSTOP
    DEFPUSHBUTTON "אישור", IDOK, 156, 121, 50, 14
    PUSHBUTTON "ביטול", IDCANCEL, 211, 121, 50, 14
}

