#pragma code_page(65001) // enable UTF-8

#include "resource.h"

LANGUAGE LANG_HEBREW, SUBLANG_HEBREW_ISRAEL

STRINGTABLE
{
    // Windows 7 shell32.dll string #29952
    IDS_OPENWITH_RECOMMENDED "תוכניות מומלצות"
    // Windows 7 shell32.dll string #29953
    IDS_OPENWITH_OTHERS "תוכניות אחרות"
    // Windows XP shell32.dll string #29952
    IDS_OPENWITH_RECOMMENDED_XP "תוכניות מומלצות:"
    // Windows XP shell32.dll string #29953
    IDS_OPENWITH_OTHERS_XP "תוכניות אחרות:"
    // Split from Windows 7 shell32.dll string #9014
    IDS_PROGRAMSFILTER "Programs"
    // Split from Windows 7 shell32.dll string #9014
    IDS_ALLFILESFILTER "All Files"
    // Windows 7 shell32.dll string #9016
    IDS_OPENAS "פתיחה באמצעות..."
    // Windows Vista shell32.dll string #9016
    IDS_OPENAS_VISTA "פתיחה באמצעות..."
}

// Windows 7 shell32.dll dialog #1063
DLG_OPENAS DIALOGEX 0, 0, 375, 271
CAPTION "פתיחה באמצעות"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
EXSTYLE WS_EX_LAYOUTRTL
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "בחר את התוכנית בה ברצונך להשתמש לפתיחת קובץ זה:", IDD_TEXT, 36, 7, 208, 8, NOT WS_GROUP
    LTEXT "קובץ:", IDC_STATIC, 36, 23, 20, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 60, 23, 191, 8, SS_NOPREFIX, WS_EX_RTLREADING
    CONTROL "", IDD_APPLIST, "SysListView32", LVS_NOSORTHEADER | LVS_NOCOLUMNHEADER | LVS_SHAREIMAGELISTS | LVS_SHOWSELALWAYS | LVS_SINGLESEL | LVS_REPORT | WS_BORDER | WS_TABSTOP, 6, 36, 361, 170
    AUTOCHECKBOX "ה&שתמש תמיד בתוכנית שנבחרה לפתיחת קבצים מסוג זה", IDD_MAKEASSOC, 6, 211, 208, 10
    PUSHBUTTON "&עיון...", IDD_OPENWITH_BROWSE, 318, 211, 50, 14
    CONTROL "אם התוכנית הרצויה אינה מופיעה ברשימה או אינה נמצאת במחשב שלך, באפשרותך <A ID=""Browse"">לחפש את התוכנית המתאימה באינטרנט</A>.", IDD_OPENWITH_WEBSITE, "SysLink", WS_TABSTOP, 8, 230, 359, 16
    DEFPUSHBUTTON "אישור", IDOK, 264, 251, 50, 14
    PUSHBUTTON "ביטול", IDCANCEL, 318, 251, 50, 14
}

