#pragma code_page(65001) // enable UTF-8

#include "resource.h"

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_TRADITIONAL

STRINGTABLE
{
    // Windows 7 shell32.dll string #29952
    IDS_OPENWITH_RECOMMENDED "建議的程式"
    // Windows 7 shell32.dll string #29953
    IDS_OPENWITH_OTHERS "其他程式"
    // Windows XP shell32.dll string #29952
    IDS_OPENWITH_RECOMMENDED_XP "建議的程式:"
    // Windows XP shell32.dll string #29953
    IDS_OPENWITH_OTHERS_XP "其他程式:"
    // Split from Windows 7 shell32.dll string #9014
    IDS_PROGRAMSFILTER "程式"
    // Split from Windows 7 shell32.dll string #9014
    IDS_ALLFILESFILTER "所有檔案"
    // Windows 7 shell32.dll string #9016
    IDS_OPENAS "開啟檔案..."
    // Windows Vista shell32.dll string #9016
    IDS_OPENAS_VISTA "開啟檔案..."
}

// Windows 7 shell32.dll dialog #1063
DLG_OPENAS DIALOGEX 0, 0, 375, 271
CAPTION "開啟檔案"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 9, "新細明體", 0, 0, 136 // CHINESEBIG5_CHARSET
{
    ICON 134, IDD_ICON, 7, 7, 21, 22, SS_REALSIZECONTROL
    LTEXT "選擇您想要用來開啟這個檔案的程式:", IDD_TEXT, 36, 7, 208, 9, NOT WS_GROUP
    LTEXT "檔案:", IDC_STATIC, 36, 23, 20, 9, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 60, 23, 208, 8, SS_NOPREFIX
    CONTROL "", IDD_APPLIST, "SysListView32", LVS_NOSORTHEADER | LVS_NOCOLUMNHEADER | LVS_SHAREIMAGELISTS | LVS_SHOWSELALWAYS | LVS_SINGLESEL | LVS_REPORT | WS_BORDER | WS_TABSTOP, 6, 36, 361, 170
    AUTOCHECKBOX "永遠用選取的程式來開啟這種檔案(&A)", IDD_MAKEASSOC, 6, 211, 202, 10
    PUSHBUTTON "瀏覽(&B)...", IDD_OPENWITH_BROWSE, 318, 211, 50, 14
    CONTROL "如果程式不在清單中或不在您的電腦上，您可以<A ID=""Browse"">從網路上尋找適當的程式</A>。", IDD_OPENWITH_WEBSITE, "SysLink", WS_TABSTOP, 8, 230, 359, 16
    DEFPUSHBUTTON "確定", IDOK, 264, 251, 50, 14
    PUSHBUTTON "取消", IDCANCEL, 318, 251, 50, 14
}

