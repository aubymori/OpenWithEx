// Windows 7 shell32.dll dialog #1091
DLG_OPENAS_DOWNALOAD DIALOGEX 0, 0, 279, 146
CAPTION "Windows"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 9, "新細明體", 0, 0, 136 // CHINESEBIG5_CHARSET
{
    ICON 134, IDD_ICON, 7, 7, 21, 22, SS_REALSIZECONTROL
    LTEXT "Windows 無法開啟這個檔案:", IDC_STATIC, 36, 7, 208, 9, NOT WS_GROUP
    LTEXT "檔案:", IDC_STATIC, 36, 23, 20, 9, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 60, 23, 208, 8, SS_NOPREFIX
    LTEXT "若要開啟這個檔案，Windows 必須知道您想要使用哪個程式來開啟它。Windows 可以連線以自動搜尋該程式，也可以手動從電腦上安裝的程式清單進行選取。", IDC_STATIC, 9, 39, 257, 24, NOT WS_GROUP
    LTEXT "您要做什麼?", IDC_STATIC, 9, 72, 139, 9, NOT WS_GROUP
    AUTORADIOBUTTON "使用 Web 服務，尋找正確程式(&W)", IDD_WEBAUTOLOOKUP, 9, 86, 194, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "從已安裝程式的清單選取程式(&S)", IDD_OPENWITHLIST, 9, 99, 194, 10, WS_TABSTOP
    DEFPUSHBUTTON "確定", IDOK, 156, 121, 50, 14
    PUSHBUTTON "取消", IDCANCEL, 211, 121, 50, 14
}

