// Windows 7 shell32.dll dialog #1063
DLG_OPENAS DIALOGEX 0, 0, 375, 271
CAPTION "Otvorenie v programe"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "Vyberte program, v ktorom sa má otvárať tento súbor:", IDD_TEXT, 36, 7, 208, 8, NOT WS_GROUP
    LTEXT "Súbor:", IDC_STATIC, 36, 23, 22, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 60, 23, 208, 8, SS_NOPREFIX
    CONTROL "", IDD_APPLIST, "SysListView32", LVS_NOSORTHEADER | LVS_NOCOLUMNHEADER | LVS_SHAREIMAGELISTS | LVS_SHOWSELALWAYS | LVS_SINGLESEL | LVS_REPORT | WS_BORDER | WS_TABSTOP, 6, 36, 361, 170
    AUTOCHECKBOX "N&a otvorenie týchto súborov vždy použiť vybratý program", IDD_MAKEASSOC, 6, 211, 202, 10
    PUSHBUTTON "P&rehľadávať...", IDD_OPENWITH_BROWSE, 309, 211, 58, 14
    CONTROL "Ak požadovaný program nie je v zozname ani na počítači, môžete <A ID=""Browse"">vyhľadať príslušný program na webe</A>.", IDD_OPENWITH_WEBSITE, "SysLink", WS_TABSTOP, 8, 230, 359, 16
    DEFPUSHBUTTON "OK", IDOK, 256, 251, 50, 14
    PUSHBUTTON "Zrušiť", IDCANCEL, 309, 251, 58, 14
}

