// Windows 7 shell32.dll dialog #1091
DLG_OPENAS_DOWNALOAD DIALOGEX 0, 0, 279, 146
CAPTION "Windows"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "Impossibile aprire il file:", IDC_STATIC, 36, 7, 208, 8, NOT WS_GROUP
    LTEXT "File:", IDC_STATIC, 36, 23, 20, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 60, 23, 208, 8, SS_NOPREFIX
    LTEXT "Per aprire il file occorre indicare il programma con cui si desidera aprirlo. È possibile eseguire una ricerca automatica sul Web o selezionare manualmente il programma da un elenco di programmi installati sul computer in uso.", IDC_STATIC, 9, 39, 257, 24, NOT WS_GROUP
    LTEXT "Scegliere l'operazione da effettuare.", IDC_STATIC, 9, 72, 139, 8, NOT WS_GROUP
    AUTORADIOBUTTON "Utilizza il servizio di ricerca sul &Web per trovare il programma", IDD_WEBAUTOLOOKUP, 9, 86, 238, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Selezionare il programma da un elenco di programmi installati", IDD_OPENWITHLIST, 9, 99, 240, 10, WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 156, 121, 50, 14
    PUSHBUTTON "Annulla", IDCANCEL, 211, 121, 50, 14
}

