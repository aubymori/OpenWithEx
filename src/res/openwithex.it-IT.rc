// Windows 7 shell32.dll dialog #1063
DLG_OPENAS DIALOGEX 0, 0, 375, 271
CAPTION "Apri con"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "Scegliere il programma da utilizzare per aprire il file:", IDD_TEXT, 36, 7, 208, 8, NOT WS_GROUP
    LTEXT "File:", IDC_STATIC, 36, 23, 20, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 60, 23, 208, 8, SS_NOPREFIX
    CONTROL "", IDD_APPLIST, "SysListView32", LVS_NOSORTHEADER | LVS_NOCOLUMNHEADER | LVS_SHAREIMAGELISTS | LVS_SHOWSELALWAYS | LVS_SINGLESEL | LVS_REPORT | WS_BORDER | WS_TABSTOP, 6, 36, 361, 170
    AUTOCHECKBOX "&Usa sempre il programma selezionato per aprire questo tipo di file", IDD_MAKEASSOC, 6, 211, 305, 10
    PUSHBUTTON "&Sfoglia...", IDD_OPENWITH_BROWSE, 318, 211, 50, 14
    CONTROL "Se il programma non è presente nell'elenco o sul computer in uso, è possibile eseguire una ricerca <A ID=""Browse"">sul Web</A>.", IDD_OPENWITH_WEBSITE, "SysLink", WS_TABSTOP, 8, 230, 361, 16
    DEFPUSHBUTTON "OK", IDOK, 264, 251, 50, 14
    PUSHBUTTON "Annulla", IDCANCEL, 318, 251, 50, 14
}

