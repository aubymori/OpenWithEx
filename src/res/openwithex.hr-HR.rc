// Windows 7 shell32.dll dialog #1091
DLG_OPENAS_DOWNALOAD DIALOGEX 0, 0, 279, 146
CAPTION "Windows"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "Sustav Windows ne može otvoriti datoteku:", IDC_STATIC, 36, 7, 208, 8, NOT WS_GROUP
    LTEXT "Datoteka:", IDC_STATIC, 36, 23, 80, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 69, 23, 199, 8, SS_NOPREFIX
    LTEXT "Da biste otvorili datoteku, Windows mora znati kojim je programom želite otvoriti. Windows se može povezati s internetom da bi program pronašao automatski ili ga možete odabrati s popisa programa instaliranih na računalu.", IDC_STATIC, 9, 39, 257, 38, NOT WS_GROUP
    LTEXT "Što želite učiniti?", IDC_STATIC, 9, 77, 139, 8, NOT WS_GROUP
    AUTORADIOBUTTON "Pronađi odgovarajući program putem &web-servisa", IDD_WEBAUTOLOOKUP, 9, 89, 248, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Odaberite program s popisa instaliranih programa", IDD_OPENWITHLIST, 9, 102, 194, 10, WS_TABSTOP
    DEFPUSHBUTTON "U redu", IDOK, 156, 121, 50, 14
    PUSHBUTTON "Odustani", IDCANCEL, 211, 121, 50, 14
}

