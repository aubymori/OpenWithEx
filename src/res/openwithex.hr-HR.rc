}

// Windows 7 shell32.dll dialog #1063
DLG_OPENAS DIALOGEX 0, 0, 375, 271
CAPTION "Otvori programom"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "Odaberite program kojim želite otvoriti datoteku:", IDD_TEXT, 36, 7, 208, 8, NOT WS_GROUP
    LTEXT "Datoteka:", IDC_STATIC, 36, 23, 32, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 73, 23, 208, 8, SS_NOPREFIX
    CONTROL "", IDD_APPLIST, "SysListView32", LVS_NOSORTHEADER | LVS_NOCOLUMNHEADER | LVS_SHAREIMAGELISTS | LVS_SHOWSELALWAYS | LVS_SINGLESEL | LVS_REPORT | WS_BORDER | WS_TABSTOP, 6, 36, 361, 170
    AUTOCHECKBOX "&Za otvaranje ove vrste datoteka uvijek koristi odabrani program", IDD_MAKEASSOC, 6, 211, 275, 10
    PUSHBUTTON "&Pregledaj...", IDD_OPENWITH_BROWSE, 306, 211, 62, 14
    CONTROL "Ne nalazi li se na popisu program koji želite <A ID=""Browse"">odgovarajući program potražite na webu</A>.", IDD_OPENWITH_WEBSITE, "SysLink", WS_TABSTOP, 8, 230, 359, 16
    DEFPUSHBUTTON "U redu", IDOK, 239, 251, 62, 14
    PUSHBUTTON "Odustani", IDCANCEL, 306, 251, 62, 14
}

