    AUTOCHECKBOX "&Za otvaranje ovog protokola uvijek koristi ovaj program", IDD_MAKEASSOC, 7, 131, 218, 10
    DEFPUSHBUTTON "U redu", IDOK, 121, 157, 50, 14, WS_DISABLED
    PUSHBUTTON "Odustani", IDCANCEL, 175, 157, 50, 14
}