// Windows 7 shell32.dll dialog #1091
DLG_OPENAS_DOWNALOAD DIALOGEX 0, 0, 279, 154
CAPTION "Windows"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "Det går inte att öppna filen:", IDC_STATIC, 36, 7, 208, 8, NOT WS_GROUP
    LTEXT "Fil:", IDC_STATIC, 36, 23, 20, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 60, 23, 208, 8, SS_NOPREFIX
    LTEXT "Den här filen kan inte öppnas om inte Windows känner till vilket program du vill använda för att öppna den. En automatisk sökning kan göras på Internet, eller så kan du välja själv i en lista över program som är installerade på datorn.", IDC_STATIC, 9, 39, 257, 35, NOT WS_GROUP
    LTEXT "Vad vill du göra?", IDC_STATIC, 9, 80, 139, 8, NOT WS_GROUP
    AUTORADIOBUTTON "&Använd webbtjänsten för att hitta rätt program", IDD_WEBAUTOLOOKUP, 9, 94, 194, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "V&älj program i en lista över installerade program", IDD_OPENWITHLIST, 9, 107, 194, 10, WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 156, 129, 50, 14
    PUSHBUTTON "Avbryt", IDCANCEL, 211, 129, 50, 14
}

