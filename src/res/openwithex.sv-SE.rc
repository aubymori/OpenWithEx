// Windows 7 shell32.dll dialog #1063
DLG_OPENAS DIALOGEX 0, 0, 375, 271
CAPTION "Öppna med"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "Markera det program som du vill använda för att öppna den här filen:", IDD_TEXT, 36, 7, 292, 8, NOT WS_GROUP
    LTEXT "Fil:", IDC_STATIC, 36, 23, 20, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 60, 23, 208, 8, SS_NOPREFIX
    CONTROL "", IDD_APPLIST, "SysListView32", LVS_NOSORTHEADER | LVS_NOCOLUMNHEADER | LVS_SHAREIMAGELISTS | LVS_SHOWSELALWAYS | LVS_SINGLESEL | LVS_REPORT | WS_BORDER | WS_TABSTOP, 6, 36, 361, 170
    AUTOCHECKBOX "&Använd alltid detta program för att öppna den här filtypen", IDD_MAKEASSOC, 6, 211, 202, 10
    PUSHBUTTON "&Bläddra...", IDD_OPENWITH_BROWSE, 318, 211, 50, 14
    CONTROL "Om det program du vill använda inte finns i listan eller på din dator kan du <A ID=""Browse"">söka efter programmet på Internet</A>.", IDD_OPENWITH_WEBSITE, "SysLink", WS_TABSTOP, 8, 230, 359, 16
    DEFPUSHBUTTON "OK", IDOK, 264, 251, 50, 14
    PUSHBUTTON "Avbryt", IDCANCEL, 318, 251, 50, 14
}

