LANGUAGE LANG_SWEDISH, SUBLANG_SWEDISH

STRINGTABLE
{
    // Windows 7 shell32.dll string #29952
    IDS_OPENWITH_RECOMMENDED "Rekommenderade program"
    // Windows 7 shell32.dll string #29953
    IDS_OPENWITH_OTHERS "Andra program"
    // Windows XP shell32.dll string #29952
    IDS_OPENWITH_RECOMMENDED_XP "Rekommenderade program:"
    // Windows XP shell32.dll string #29953
    IDS_OPENWITH_OTHERS_XP "Andra program:"
    // Split from Windows 7 shell32.dll string #9014
    IDS_PROGRAMSFILTER "Program"
    // Split from Windows 7 shell32.dll string #9014
    IDS_ALLFILESFILTER "Alla filer"
