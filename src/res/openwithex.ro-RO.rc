#pragma code_page(65001) // enable UTF-8

#include "resource.h"

LANGUAGE LANG_ROMANIAN, SUBLANG_ROMANIAN_ROMANIA

STRINGTABLE
{
    // Windows 7 shell32.dll string #29952
    IDS_OPENWITH_RECOMMENDED "Programe recomandate"
    // Windows 7 shell32.dll string #29953
    IDS_OPENWITH_OTHERS "Alte programe"
    // Windows XP shell32.dll string #29952
    IDS_OPENWITH_RECOMMENDED_XP "Programe recomandate:"
    // Windows XP shell32.dll string #29953
    IDS_OPENWITH_OTHERS_XP "Alte programe:"
    // Split from Windows 7 shell32.dll string #9014
    IDS_PROGRAMSFILTER "Programe"
    // Split from Windows 7 shell32.dll string #9014
    IDS_ALLFILESFILTER "Toate fișierele"
    // Windows 7 shell32.dll string #9016
    IDS_OPENAS "Deschidere cu..."
    // Windows Vista shell32.dll string #9016
    IDS_OPENAS_VISTA "Deschidere cu..."
}

// Windows 7 shell32.dll dialog #1063
DLG_OPENAS DIALOGEX 0, 0, 375, 271
CAPTION "Deschidere cu"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "Alegeți programul pentru a deschide acest fișier:", IDD_TEXT, 36, 7, 208, 8, NOT WS_GROUP
    LTEXT "Fișier:", IDC_STATIC, 36, 23, 20, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 60, 23, 208, 8, SS_NOPREFIX
    CONTROL "", IDD_APPLIST, "SysListView32", LVS_NOSORTHEADER | LVS_NOCOLUMNHEADER | LVS_SHAREIMAGELISTS | LVS_SHOWSELALWAYS | LVS_SINGLESEL | LVS_REPORT | WS_BORDER | WS_TABSTOP, 6, 36, 361, 170
    AUTOCHECKBOX "Pr&ogramul selectat va deschide întotdeauna acest tip de fișier", IDD_MAKEASSOC, 6, 211, 210, 10
    PUSHBUTTON "&Răsfoire...", IDD_OPENWITH_BROWSE, 318, 211, 50, 14
    CONTROL "Dacă programul nu este în listă sau pe computer, <A ID=""Browse"">căutați programul adecvat pe Web</A>.", IDD_OPENWITH_WEBSITE, "SysLink", WS_TABSTOP, 8, 230, 359, 16
    DEFPUSHBUTTON "OK", IDOK, 264, 251, 50, 14
    PUSHBUTTON "Revocare", IDCANCEL, 318, 251, 50, 14
}

