    IDS_OPENAS "Άνοιγμα με..."
    // Windows Vista shell32.dll string #9016
    IDS_OPENAS_VISTA "Άνοιγμα με..."
}

// Windows 7 shell32.dll dialog #1063
DLG_OPENAS DIALOGEX 0, 0, 375, 271
CAPTION "Άνοιγμα με"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "Επιλέξτε το πρόγραμμα που θέλετε να χρησιμοποιήσετε για άνοιγμα αυτού του αρχείου:", IDD_TEXT, 36, 7, 298, 8, NOT WS_GROUP
    LTEXT "Αρχείο:", IDC_STATIC, 36, 23, 26, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 67, 23, 208, 8, SS_NOPREFIX
    CONTROL "", IDD_APPLIST, "SysListView32", LVS_NOSORTHEADER | LVS_NOCOLUMNHEADER | LVS_SHAREIMAGELISTS | LVS_SHOWSELALWAYS | LVS_SINGLESEL | LVS_REPORT | WS_BORDER | WS_TABSTOP, 6, 36, 361, 170
    AUTOCHECKBOX "Ά&νοιγμα αυτού του είδους αρχείου πάντα με το επιλεγμένο πρόγραμμα", IDD_MAKEASSOC, 6, 211, 255, 10
    PUSHBUTTON "Ανα&ζήτηση...", IDD_OPENWITH_BROWSE, 318, 211, 50, 14
    CONTROL "Αν το πρόγραμμα που θέλετε δεν είναι στη λίστα ή στον υπολογιστή σας, μπορείτε να <A ID=""Browse"">αναζητήσετε το κατάλληλο πρόγραμμα στο Web</A>.", IDD_OPENWITH_WEBSITE, "SysLink", WS_TABSTOP, 8, 230, 359, 16
    DEFPUSHBUTTON "ΟΚ", IDOK, 264, 251, 50, 14
    PUSHBUTTON "Άκυρο", IDCANCEL, 318, 251, 50, 14
}

