LANGUAGE LANG_GREEK, SUBLANG_GREEK_GREECE

STRINGTABLE
{
    // Windows 7 shell32.dll string #29952
    IDS_OPENWITH_RECOMMENDED "Προτεινόμενα προγράμματα"
    // Windows 7 shell32.dll string #29953
    IDS_OPENWITH_OTHERS "Άλλα προγράμματα"
    // Windows XP shell32.dll string #29952
    IDS_OPENWITH_RECOMMENDED_XP "Προτεινόμενα προγράμματα:"
    // Windows XP shell32.dll string #29953
    IDS_OPENWITH_OTHERS_XP "Άλλα προγράμματα:"
    // Split from Windows 7 shell32.dll string #9014
    IDS_PROGRAMSFILTER "Προγράμματα"
    // Split from Windows 7 shell32.dll string #9014
    IDS_ALLFILESFILTER "Όλα τα αρχεία"
