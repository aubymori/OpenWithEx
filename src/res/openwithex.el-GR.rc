// Windows 7 shell32.dll dialog #1091
DLG_OPENAS_DOWNALOAD DIALOGEX 0, 0, 279, 146
CAPTION "Windows"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "Τα Windows δεν είναι δυνατό να ανοίξουν αυτό το αρχείο:", IDC_STATIC, 36, 7, 208, 8, NOT WS_GROUP
    LTEXT "Αρχείο:", IDC_STATIC, 36, 23, 30, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 70, 23, 198, 8, SS_NOPREFIX
    LTEXT "Για να ανοίξουν αυτό το αρχείο, τα Windows πρέπει να γνωρίζουν με ποιο πρόγραμμα θέλετε να το ανοίξετε. Μπορούν να το αναζητήσουν αυτόματα, μέσω σύνδεσης στο δίκτυο, ή να το επιλέξετε εσείς από μια λίστα των προγραμμάτων που είναι εγκατεστημένα στον υπολογιστή σας.", IDC_STATIC, 9, 39, 257, 34, NOT WS_GROUP
    LTEXT "Τι θέλετε να κάνετε;", IDC_STATIC, 9, 76, 139, 8, NOT WS_GROUP
    AUTORADIOBUTTON "Χρήση της &υπηρεσίας Web για εύρεση του σωστού προγράμματος", IDD_WEBAUTOLOOKUP, 9, 90, 263, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Επιλογή ενός προγράμματος από λίστα εγκατεστημένων προγραμμάτων", IDD_OPENWITHLIST, 9, 103, 264, 10, WS_TABSTOP
    DEFPUSHBUTTON "ΟΚ", IDOK, 161, 121, 50, 14
    PUSHBUTTON "Άκυρο", IDCANCEL, 216, 121, 50, 14
}

