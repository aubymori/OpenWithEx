#pragma code_page(65001) // enable UTF-8

#include "resource.h"

LANGUAGE LANG_SERBIAN, SUBLANG_SERBIAN_SERBIA_LATIN

STRINGTABLE
{
    // Windows 7 shell32.dll string #29952
    IDS_OPENWITH_RECOMMENDED "Preporučeni programi"
    // Windows 7 shell32.dll string #29953
    IDS_OPENWITH_OTHERS "Ostali programi"
    // Split from Windows 7 shell32.dll string #9014
    IDS_PROGRAMSFILTER "Programi"
    // Split from Windows 7 shell32.dll string #9014
    IDS_ALLFILESFILTER "Sve datoteke"
    // Windows 7 shell32.dll string #9016
    IDS_OPENAS "Otvori pomoću..."
    // Windows Vista shell32.dll string #9016
    IDS_OPENAS_VISTA "Otvori pomoću..."
}

// Windows 7 shell32.dll dialog #1063
DLG_OPENAS DIALOGEX 0, 0, 375, 271
CAPTION "Otvori pomoću"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "Odaberite program koji želite da koristite za otvaranje ove datoteke:", IDD_TEXT, 36, 7, 218, 17, NOT WS_GROUP
    LTEXT "Datoteka:", IDC_STATIC, 36, 28, 35, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 75, 28, 193, 8, SS_NOPREFIX
    CONTROL "", IDD_APPLIST, "SysListView32", LVS_NOSORTHEADER | LVS_NOCOLUMNHEADER | LVS_SHAREIMAGELISTS | LVS_SHOWSELALWAYS | LVS_SINGLESEL | LVS_REPORT | WS_BORDER | WS_TABSTOP, 6, 36, 361, 170
    AUTOCHECKBOX "&Uvek koristi izabrani program za otvaranje ove vrste datoteke", IDD_MAKEASSOC, 6, 211, 241, 10
    PUSHBUTTON "&Potraži...", IDD_OPENWITH_BROWSE, 318, 211, 50, 14
    CONTROL "Ako željeni program nije na spisku ili računaru, možete <A ID=""Browse"">potražiti odgovarajući program na Webu</A>.", IDD_OPENWITH_WEBSITE, "SysLink", WS_TABSTOP, 8, 230, 359, 16
    DEFPUSHBUTTON "U redu", IDOK, 264, 251, 50, 14
    PUSHBUTTON "Otkaži", IDCANCEL, 318, 251, 50, 14
}

