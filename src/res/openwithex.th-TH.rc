// Windows 7 shell32.dll dialog #1091
DLG_OPENAS_DOWNALOAD DIALOGEX 0, 0, 279, 146
CAPTION "Windows"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "Windows ไม่สามารถเปิดแฟ้มนี้ได้:", IDC_STATIC, 36, 7, 208, 8, NOT WS_GROUP
    LTEXT "แฟ้ม:", IDC_STATIC, 36, 23, 20, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 60, 23, 208, 8, SS_NOPREFIX
    LTEXT "เมื่อต้องการเปิดแฟ้มนี้ Windows จำเป็นต้องทราบว่าคุณต้องการใช้โปรแกรมใดเปิดแฟ้มนี้ Windows สามารถออนไลน์เพื่อค้นหาโปรแกรมดังกล่าวได้โดยอัตโนมัติ หรือคุณสามารถเลือกจากรายการโปรแกรมที่ติดตั้งอยู่บนคอมพิวเตอร์ของคุณได้ด้วยตนเอง", IDC_STATIC, 9, 36, 257, 33, NOT WS_GROUP
    LTEXT "คุณต้องการทำอะไร", IDC_STATIC, 9, 72, 139, 8, NOT WS_GROUP
    AUTORADIOBUTTON "ใ&ช้บริการเว็บในการค้นหาโปรแกรมที่ถูกต้อง", IDD_WEBAUTOLOOKUP, 9, 86, 194, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "เ&ลือกโปรแกรมจากรายการของโปรแกรมที่ติดตั้ง", IDD_OPENWITHLIST, 9, 99, 194, 10, WS_TABSTOP
    DEFPUSHBUTTON "ตกลง", IDOK, 156, 121, 50, 14
    PUSHBUTTON "ยกเลิก", IDCANCEL, 211, 121, 50, 14
}

