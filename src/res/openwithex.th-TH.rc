// Windows 7 shell32.dll dialog #1063
DLG_OPENAS DIALOGEX 0, 0, 375, 271
CAPTION "เปิดด้วย"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "เลือกโปรแกรมที่คุณต้องการใช้ในการเปิดแฟ้มนี้:", IDD_TEXT, 36, 7, 208, 8, NOT WS_GROUP
    LTEXT "แฟ้ม:", IDC_STATIC, 36, 23, 20, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 60, 23, 208, 8, SS_NOPREFIX
    CONTROL "", IDD_APPLIST, "SysListView32", LVS_NOSORTHEADER | LVS_NOCOLUMNHEADER | LVS_SHAREIMAGELISTS | LVS_SHOWSELALWAYS | LVS_SINGLESEL | LVS_REPORT | WS_BORDER | WS_TABSTOP, 6, 36, 361, 170
    AUTOCHECKBOX "ใ&ช้โปรแกรมที่เลือกในการเปิดแฟ้มชนิดนี้เสมอ", IDD_MAKEASSOC, 6, 211, 202, 10
    PUSHBUTTON "เ&รียกดู...", IDD_OPENWITH_BROWSE, 318, 211, 50, 14
    CONTROL "ถ้าโปรแกรมที่คุณต้องการไม่มีอยู่ในรายการหรือไม่ได้อยู่บนคอมพิวเตอร์ของคุณ คุณสามารถ <A ID=""Browse"">มองหาโปรแกรมที่เหมาะสมบนเว็บ</A> ได้", IDD_OPENWITH_WEBSITE, "SysLink", WS_TABSTOP, 8, 230, 359, 16
    DEFPUSHBUTTON "ตกลง", IDOK, 264, 251, 50, 14
    PUSHBUTTON "ยกเลิก", IDCANCEL, 318, 251, 50, 14
}

