#pragma code_page(65001) // enable UTF-8

#include "resource.h"

LANGUAGE LANG_JAPANESE, SUBLANG_JAPANESE_JAPAN

STRINGTABLE
{
    // Windows 7 shell32.dll string #29952
    IDS_OPENWITH_RECOMMENDED "推奨されたプログラム"
    // Windows 7 shell32.dll string #29953
    IDS_OPENWITH_OTHERS "ほかのプログラム"
    // Windows XP shell32.dll string #29952
    IDS_OPENWITH_RECOMMENDED_XP "推奨されたプログラム:"
    // Windows XP shell32.dll string #29953
    IDS_OPENWITH_OTHERS_XP "ほかのプログラム:"
    // Split from Windows 7 shell32.dll string #9014
    IDS_PROGRAMSFILTER "プログラム"
    // Split from Windows 7 shell32.dll string #9014
    IDS_ALLFILESFILTER "すべてのファイル"
    // Windows 7 shell32.dll string #9016
    IDS_OPENAS "プログラムから開く..."
    // Windows Vista shell32.dll string #9016
    IDS_OPENAS_VISTA "プログラムから開く..."
}

// Windows 7 shell32.dll dialog #1063
DLG_OPENAS DIALOGEX 0, 0, 375, 271
CAPTION "ファイルを開くプログラムの選択"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 9, "MS UI Gothic", 0, 0, 128
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "このファイルの種類を開くプログラムを選択してください:", IDD_TEXT, 36, 7, 208, 8, NOT WS_GROUP
    LTEXT "ファイル:", IDC_STATIC, 36, 23, 26, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 66, 23, 208, 8, SS_NOPREFIX
    CONTROL "", IDD_APPLIST, "SysListView32", LVS_NOSORTHEADER | LVS_NOCOLUMNHEADER | LVS_SHAREIMAGELISTS | LVS_SHOWSELALWAYS | LVS_SINGLESEL | LVS_REPORT | WS_BORDER | WS_TABSTOP, 6, 36, 361, 170
    AUTOCHECKBOX "この種類のファイルを開くときは、選択したプログラムをいつも使う(&A)", IDD_MAKEASSOC, 6, 211, 202, 10
    PUSHBUTTON "参照(&B)...", IDD_OPENWITH_BROWSE, 318, 211, 50, 14
    CONTROL "使用するプログラムが一覧やコンピューターにない場合は、<A ID=""Browse"">適切なプログラムを Web で探す</A>ことができます。", IDD_OPENWITH_WEBSITE, "SysLink", WS_TABSTOP, 8, 230, 359, 16
    DEFPUSHBUTTON "OK", IDOK, 264, 251, 50, 14
    PUSHBUTTON "キャンセル", IDCANCEL, 318, 251, 50, 14
}

