// Windows 7 shell32.dll dialog #1091
DLG_OPENAS_DOWNALOAD DIALOGEX 0, 0, 279, 146
CAPTION "Windows"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 9, "MS UI Gothic", 0, 0, 128 // SHIFTJIS_CHARSET
{
    ICON 134, IDD_ICON, 7, 7, 18, 19, SS_REALSIZECONTROL
    LTEXT "このファイルを開けません:", IDC_STATIC, 36, 7, 208, 8, NOT WS_GROUP
    LTEXT "ファイル:", IDC_STATIC, 36, 23, 26, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 65, 23, 208, 8, SS_NOPREFIX
    LTEXT "このファイルを開くには、そのためのプログラムが必要です。インターネットで自動的にプログラムを検索するか、またはコンピューターにインストールされたプログラムの一覧から手動で選択してください。", IDC_STATIC, 9, 39, 257, 24, NOT WS_GROUP
    LTEXT "動作を選択してください。", IDC_STATIC, 9, 72, 139, 8, NOT WS_GROUP
    AUTORADIOBUTTON "Web サービスを使用して正しいプログラムを探す(&W)", IDD_WEBAUTOLOOKUP, 9, 86, 194, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "インストールされたプログラムの一覧からプログラムを選択する(&S)", IDD_OPENWITHLIST, 9, 99, 201, 10, WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 156, 121, 50, 14
    PUSHBUTTON "キャンセル", IDCANCEL, 211, 121, 50, 14
}

