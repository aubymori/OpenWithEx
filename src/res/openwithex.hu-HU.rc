// Windows 7 shell32.dll dialog #1063
DLG_OPENAS DIALOGEX 0, 0, 375, 271
CAPTION "Társítás"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "Válassza ki a fájl megnyitásához használni kívánt programot:", IDD_TEXT, 36, 7, 208, 8, NOT WS_GROUP
    LTEXT "Fájl:", IDC_STATIC, 36, 23, 20, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 60, 23, 208, 8, SS_NOPREFIX
    CONTROL "", IDD_APPLIST, "SysListView32", LVS_NOSORTHEADER | LVS_NOCOLUMNHEADER | LVS_SHAREIMAGELISTS | LVS_SHOWSELALWAYS | LVS_SINGLESEL | LVS_REPORT | WS_BORDER | WS_TABSTOP, 6, 36, 361, 170
    AUTOCHECKBOX "&Mindig a kijelölt program nyissa meg az ilyen típusú fájlokat", IDD_MAKEASSOC, 6, 211, 251, 10
    PUSHBUTTON "&Tallózás...", IDD_OPENWITH_BROWSE, 318, 211, 50, 14
    CONTROL "Ha a keresett program nincs a listában vagy nincs telepítve, a weben is <A ID=""Browse"">kereshet megfelelő programot</A>.", IDD_OPENWITH_WEBSITE, "SysLink", WS_TABSTOP, 8, 230, 359, 16
    DEFPUSHBUTTON "OK", IDOK, 264, 251, 50, 14
    PUSHBUTTON "Mégse", IDCANCEL, 318, 251, 50, 14
}

