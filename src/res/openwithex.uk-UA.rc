// Windows 7 shell32.dll dialog #1091
DLG_OPENAS_DOWNALOAD DIALOGEX 0, 0, 279, 146
CAPTION "Windows"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "Не вдалося відкрити такий файл:", IDC_STATIC, 36, 7, 231, 8, NOT WS_GROUP
    LTEXT "Файл:", IDC_STATIC, 36, 23, 23, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 64, 23, 204, 8, SS_NOPREFIX
    LTEXT "Щоб відкрити цей файл, слід указати системі, яку програму для цього використовувати.  Ви можете дозволити Windows автоматично знайти відповідну програму в Інтернеті або вручну вибрати програму зі списку програм на комп’ютері.", IDC_STATIC, 9, 39, 257, 33, NOT WS_GROUP
    LTEXT "Що зробити?", IDC_STATIC, 9, 76, 257, 8, NOT WS_GROUP
    AUTORADIOBUTTON "&Пошук відповідної програми в Інтернеті", IDD_WEBAUTOLOOKUP, 9, 90, 257, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Вибрати програму зі списку інстальованих програм", IDD_OPENWITHLIST, 9, 103, 257, 10, WS_TABSTOP
    DEFPUSHBUTTON "ОК", IDOK, 156, 121, 50, 14
    PUSHBUTTON "Скасувати", IDCANCEL, 211, 121, 50, 14
}

