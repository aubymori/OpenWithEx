// Windows 7 shell32.dll dialog #1063
DLG_OPENAS DIALOGEX 0, 0, 375, 271
CAPTION "Відкрити за допомогою"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "Виберіть програму, за допомогою якої слід відкрити цей файл:", IDD_TEXT, 36, 7, 217, 16, NOT WS_GROUP
    LTEXT "Файл:", IDC_STATIC, 36, 23, 22, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 62, 23, 189, 8, SS_NOPREFIX
    CONTROL "", IDD_APPLIST, "SysListView32", LVS_NOSORTHEADER | LVS_NOCOLUMNHEADER | LVS_SHAREIMAGELISTS | LVS_SHOWSELALWAYS | LVS_SINGLESEL | LVS_REPORT | WS_BORDER | WS_TABSTOP, 6, 36, 361, 170
    AUTOCHECKBOX "Зав&жди відкривати файли цього типу за допомогою цієї програми", IDD_MAKEASSOC, 6, 211, 297, 10
    PUSHBUTTON "О&гляд...", IDD_OPENWITH_BROWSE, 318, 211, 50, 14
    CONTROL "Якщо потрібної програми немає в списку або на цьому комп'ютері, можна <A ID=""Browse"">пошукати програму в Інтернеті</A>.", IDD_OPENWITH_WEBSITE, "SysLink", WS_TABSTOP, 8, 230, 359, 16
    DEFPUSHBUTTON "ОК", IDOK, 264, 251, 50, 14
    PUSHBUTTON "Скасувати", IDCANCEL, 318, 251, 50, 14
}

