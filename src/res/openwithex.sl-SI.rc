// Windows 7 shell32.dll dialog #1091
DLG_OPENAS_DOWNALOAD DIALOGEX 0, 0, 279, 146
CAPTION "Windows"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "Windows ne more odpreti te datoteke:", IDC_STATIC, 36, 7, 208, 8, NOT WS_GROUP
    LTEXT "Datoteka:", IDC_STATIC, 36, 23, 32, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 72, 23, 196, 8, SS_NOPREFIX
    LTEXT "Če želite odpreti to datoteko, mora Windows vedeti, s katerim programom jo želite odpreti. Windows ga lahko samodejno poišče v spletu, lahko pa ga ročno izberete na seznamu programov, ki so nameščeni v računalniku.", IDC_STATIC, 9, 37, 257, 33, NOT WS_GROUP
    LTEXT "Kaj želite narediti?", IDC_STATIC, 9, 72, 139, 8, NOT WS_GROUP
    AUTORADIOBUTTON "S &spletno storitvijo najti pravilen program", IDD_WEBAUTOLOOKUP, 9, 86, 194, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Izbrati program s seznama nameščenih programov", IDD_OPENWITHLIST, 9, 99, 194, 10, WS_TABSTOP
    DEFPUSHBUTTON "V redu", IDOK, 156, 121, 50, 14
    PUSHBUTTON "Prekliči", IDCANCEL, 211, 121, 50, 14
}

