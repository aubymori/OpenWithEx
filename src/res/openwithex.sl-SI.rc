// Windows 7 shell32.dll dialog #1063
DLG_OPENAS DIALOGEX 0, 0, 375, 271
CAPTION "Za odpiranje uporabi"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "Izberite program, s katerim želite odpreti to datoteko:", IDD_TEXT, 36, 7, 208, 8, NOT WS_GROUP
    LTEXT "Datoteka:", IDC_STATIC, 36, 23, 32, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 73, 23, 208, 8, SS_NOPREFIX
    CONTROL "", IDD_APPLIST, "SysListView32", LVS_NOSORTHEADER | LVS_NOCOLUMNHEADER | LVS_SHAREIMAGELISTS | LVS_SHOWSELALWAYS | LVS_SINGLESEL | LVS_REPORT | WS_BORDER | WS_TABSTOP, 6, 36, 361, 170
    AUTOCHECKBOX "D&atoteke te vrste vedno odpri z izbranim programom", IDD_MAKEASSOC, 6, 211, 249, 10
    PUSHBUTTON "P&rebrskaj ...", IDD_OPENWITH_BROWSE, 318, 211, 50, 14
    CONTROL "Če programa, ki ga želite uporabiti, ni na seznamu ali v vašem računalniku, ga lahko <A ID=""Browse"">poiščete v spletu</A>.", IDD_OPENWITH_WEBSITE, "SysLink", WS_TABSTOP, 8, 230, 359, 16
    DEFPUSHBUTTON "V redu", IDOK, 264, 251, 50, 14
    PUSHBUTTON "Prekliči", IDCANCEL, 318, 251, 50, 14
}

