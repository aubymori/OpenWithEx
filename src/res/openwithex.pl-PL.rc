#pragma code_page(65001) // enable UTF-8

#include "resource.h"

LANGUAGE LANG_POLISH, SUBLANG_POLISH_POLAND

STRINGTABLE
{
    // Windows 7 shell32.dll string #29952
    IDS_OPENWITH_RECOMMENDED "Zalecane programy"
    // Windows 7 shell32.dll string #29953
    IDS_OPENWITH_OTHERS "Inne programy"
    // Windows XP shell32.dll string #29952
    IDS_OPENWITH_RECOMMENDED_XP "Zalecane programy:"
    // Windows XP shell32.dll string #29953
    IDS_OPENWITH_OTHERS_XP "Inne programy:"
    // Split from Windows 7 shell32.dll string #9014
    IDS_PROGRAMSFILTER "Programy"
    // Split from Windows 7 shell32.dll string #9014
    IDS_ALLFILESFILTER "Wszystkie pliki"
    // Windows 7 shell32.dll string #9016
    IDS_OPENAS "Otwieranie za pomocą..."
    // Windows Vista shell32.dll string #9016
    IDS_OPENAS_VISTA "Otwieranie za pomocą..."
}

// Windows 7 shell32.dll dialog #1063
DLG_OPENAS DIALOGEX 0, 0, 375, 271
CAPTION "Otwieranie za pomocą"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "Wybierz program, którego chcesz użyć do otwarcia tego pliku:", IDD_TEXT, 36, 7, 208, 8, NOT WS_GROUP
    LTEXT "Plik:", IDC_STATIC, 36, 23, 20, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 60, 23, 208, 8, SS_NOPREFIX
    CONTROL "", IDD_APPLIST, "SysListView32", LVS_NOSORTHEADER | LVS_NOCOLUMNHEADER | LVS_SHAREIMAGELISTS | LVS_SHOWSELALWAYS | LVS_SINGLESEL | LVS_REPORT | WS_BORDER | WS_TABSTOP, 6, 36, 361, 170
    AUTOCHECKBOX "&Zawsze używaj wybranego programu do otwierania tego typu plików", IDD_MAKEASSOC, 6, 211, 262, 10
    PUSHBUTTON "Prz&eglądaj...", IDD_OPENWITH_BROWSE, 318, 211, 50, 14
    CONTROL "Jeśli potrzebnego programu nie ma na liście ani na tym komputerze, możesz <A ID=""Browse"">poszukać odpowiedniego programu w sieci Web</A>.", IDD_OPENWITH_WEBSITE, "SysLink", WS_TABSTOP, 8, 230, 359, 16
    DEFPUSHBUTTON "OK", IDOK, 264, 251, 50, 14
    PUSHBUTTON "Anuluj", IDCANCEL, 318, 251, 50, 14
}

