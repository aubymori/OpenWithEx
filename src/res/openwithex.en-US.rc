#pragma code_page(65001) // enable UTF-8

#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

STRINGTABLE
{
    // Windows 7 shell32.dll string #29952
    IDS_OPENWITH_RECOMMENDED "Recommended Programs"
    // Windows 7 shell32.dll string #29953
    IDS_OPENWITH_OTHERS "Other Programs"
    // Windows XP shell32.dll string #29952
    IDS_OPENWITH_RECOMMENDED_XP "Recommended Programs:"
    // Windows XP shell32.dll string #29953
    IDS_OPENWITH_OTHERS_XP "Other Programs:"
    // Split from Windows 7 shell32.dll string #9014
    IDS_PROGRAMSFILTER "Programs"
    // Split from Windows 7 shell32.dll string #9014
    IDS_ALLFILESFILTER "All Files"
    // Windows 7 shell32.dll string #9016
    IDS_OPENAS "Open with..."
    // Windows Vista shell32.dll string #9016
    IDS_OPENAS_VISTA "Open With..."
}

// Windows 7 shell32.dll dialog #1063
DLG_OPENAS DIALOGEX 0, 0, 375, 271
CAPTION "Open with"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "Choose the program you want to use to open this file:", IDD_TEXT, 36, 7, 208, 8, NOT WS_GROUP
    LTEXT "File:", IDC_STATIC, 36, 23, 20, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 60, 23, 208, 8, SS_NOPREFIX
    CONTROL "", IDD_APPLIST, "SysListView32", LVS_NOSORTHEADER | LVS_NOCOLUMNHEADER | LVS_SHAREIMAGELISTS | LVS_SHOWSELALWAYS | LVS_SINGLESEL | LVS_REPORT | WS_BORDER | WS_TABSTOP, 6, 36, 361, 170
    AUTOCHECKBOX "&Always use the selected program to open this kind of file", IDD_MAKEASSOC, 6, 211, 202, 10
    PUSHBUTTON "&Browse...", IDD_OPENWITH_BROWSE, 318, 211, 50, 14
    CONTROL "If the program you want is not in the list or on your computer, you can <A ID=""Browse"">look for the appropriate program on the Web</A>.", IDD_OPENWITH_WEBSITE, "SysLink", WS_TABSTOP, 8, 230, 359, 16
    DEFPUSHBUTTON "OK", IDOK, 264, 251, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 318, 251, 50, 14
}

