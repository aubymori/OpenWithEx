// Windows 7 shell32.dll dialog #1091
DLG_OPENAS_DOWNALOAD DIALOGEX 0, 0, 279, 146
CAPTION "Windows"
STYLE DS_CENTER | DS_MODALFRAME | DS_SHELLFONT | WS_POPUPWINDOW | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0
{
    ICON 134, IDD_ICON, 7, 7, 21, 20, SS_REALSIZECONTROL
    LTEXT "Windows can't open this file:", IDC_STATIC, 36, 7, 208, 8, NOT WS_GROUP
    LTEXT "File:", IDC_STATIC, 36, 23, 20, 8, NOT WS_GROUP
    LTEXT "", IDD_FILE_TEXT, 60, 23, 208, 8, SS_NOPREFIX
    LTEXT "To open this file, Windows needs to know what program you want to use to open it. Windows can go online to look it up automatically, or you can manually select from a list of programs that are installed on your computer.", IDC_STATIC, 9, 39, 257, 24, NOT WS_GROUP
    LTEXT "What do you want to do?", IDC_STATIC, 9, 72, 139, 8, NOT WS_GROUP
    AUTORADIOBUTTON "Use the &Web service to find the correct program", IDD_WEBAUTOLOOKUP, 9, 86, 194, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Select a program from a list of installed programs", IDD_OPENWITHLIST, 9, 99, 194, 10, WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 156, 121, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 211, 121, 50, 14
}

